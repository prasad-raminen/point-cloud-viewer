{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Provider": "LocalDisk",
    "LocalDisk": {
      "RootPath": "data"
    },
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "point-clouds"
    }
  },
  "PointCloud": {
    "MaxPoints": 5000000,
    "LodTargetPoints": 250000,
    "MaxWarnings": 20
  },
  "Upload": {
    "MaxFileSizeBytes": 209715200
  },
  "DemoData": {
    "Enabled": true,
    "Density": 1.0,
    "Seed": 7
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
